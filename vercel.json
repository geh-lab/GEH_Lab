{
  "trailingSlash": false,
  "cleanUrls": false,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/board.html",
      "destination": "/news.html",
      "permanent": true
    },
    {
      "source": "/en/board.html",
      "destination": "/en/news.html",
      "permanent": true
    }
  ]
}
