    "preview": "vite preview",
    "verify": "npm run build && node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  }
}
