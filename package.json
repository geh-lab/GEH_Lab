{
  "name": "geh-lab-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:profiles": "node scripts/sync-profile-source.mjs",
    "generate:profiles": "node scripts/generate-member-roster.mjs",
    "dev": "npm run generate:profiles && node ./node_modules/vite/bin/vite.js",
    "build": "npm run sync:profiles -- --optional && npm run generate:profiles && node ./node_modules/vite/bin/vite.js build",
    "build:sync": "npm run build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "verify": "npm run test && npm run build && node scripts/verify-build.mjs",
    "test": "node scripts/verify-content.mjs"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  }
}
