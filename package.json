{
  "name": "geh-lab-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync:profiles": "node scripts/sync-profile-source.mjs",
    "generate:profiles": "node scripts/generate-member-roster.mjs",
    "dev": "npm run generate:profiles && vite",
    "build": "npm run sync:profiles -- --optional && npm run generate:profiles && vite build",
